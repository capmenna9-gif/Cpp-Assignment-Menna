#include <iostream>
#include <string>

using namespace std;

int main() {
    string name;
    string phone;
    
    cout << "Enter Customer Name: ";
    getline(cin, name);
    
    cout << "Enter Phone Number : ";
    cin >> phone;

    cout << "\nHello, " << name << "! Your phone is saved successfully.\n";
    return 0;
}
